{
  "name": "npl-map",
  "version": "0.2.0",
  "private": true,
  "description": "GPX route analyser for Norwegian hiking \u2014 elevation core and map shell",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tools/verify/copy-data.mjs",
    "preview": "vite preview",
    "verify": "node tools/verify/verify.mjs",
    "cf:dev": "npm run build && npx wrangler dev",
    "deploy": "npm run build && npx wrangler deploy",
    "test": "vitest run --exclude \"**/*.live.test.ts\"",
    "test:watch": "vitest --exclude \"**/*.live.test.ts\"",
    "typecheck": "tsc --noEmit",
    "profile": "tsx src/cli/profile.ts",
    "size": "node tools/verify/bundle-size.mjs",
    "visual-check": "node tools/verify/visual-check.mjs --runtime",
    "test:live": "NETWORK_TESTS=1 vitest run",
    "visual-check:static": "node tools/verify/visual-check.mjs",
    "e2e": "node tools/verify/e2e.mjs",
    "perf": "node tools/verify/perf.mjs",
    "a11y": "node tools/verify/a11y.mjs",
    "failure-paths": "node tools/verify/failure-paths.mjs",
    "i18n": "tsx tools/verify/check-i18n.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "maplibre-gl": "^6.15.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "^26.6.5",
    "fake-indexeddb": "^6.2.6",
    "playwright": "^1.58.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  }
}
