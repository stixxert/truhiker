{
  "name": "truhiker",
  "version": "0.2.0",
  "private": true,
  "description": "Route planner for multi-day walking in Norway",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node tools/preflight.mjs && vite",
    "build": "node tools/preflight.mjs && node tools/ensure-data.mjs && tsc --noEmit && vite build && node tools/verify/copy-data.mjs",
    "preview": "vite preview",
    "verify": "node tools/preflight.mjs && node tools/verify/verify.mjs",
    "cf:dev": "npm run build && npx wrangler dev",
    "deploy": "npm run build && npx wrangler deploy",
    "deploy:cron": "npx wrangler deploy -c worker/wrangler.jsonc",
    "refresh:shops": "bash tools/refresh-shops.sh",
    "data:build": "node tools/ensure-data.mjs --from-pbf \"${OSM_PBF:?set OSM_PBF to a norway-latest.osm.pbf}\"",
    "test": "node tools/preflight.mjs && vitest run --exclude \"**/*live.test.ts\"",
    "test:watch": "vitest --exclude \"**/*live.test.ts\"",
    "typecheck": "tsc --noEmit",
    "size": "node tools/verify/bundle-size.mjs",
    "screenshot": "node tools/screenshot.mjs",
    "visual-check": "node tools/verify/visual-check.mjs --runtime",
    "test:live": "NETWORK_TESTS=1 vitest run",
    "visual-check:static": "node tools/verify/visual-check.mjs",
    "e2e": "node tools/verify/e2e.mjs",
    "perf": "node tools/verify/perf.mjs",
    "a11y": "node tools/verify/a11y.mjs",
    "failure-paths": "node tools/verify/failure-paths.mjs",
    "i18n": "tsx tools/verify/check-i18n.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "maplibre-gl": "^6.15.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "^26.6.5",
    "fake-indexeddb": "^6.2.6",
    "playwright": "^1.58.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20261019.1": true
  }
}
