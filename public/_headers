# Static assets on Cloudflare Workers.
#
# One block per concern, and every header appears in exactly ONE block:
# Cloudflare concatenates duplicate header definitions across matching rules
# (verified under `wrangler dev`: a header defined twice arrives as
# "nosniff\nnosniff"). One definition per header, or the browser receives an
# invalid multi-value response.

# HTML must never be cached immutably.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Data and the demo route: an hour is enough; both change with the deployment.
/demo/*
/data/*
  Cache-Control: public, max-age=3600

# Hashed build output: immutable for a year.
/*.js
/*.mjs
/*.css
  Cache-Control: public, max-age=31536000, immutable

# Security headers for every path, including "/" and anything added later.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cache.kartverket.no https://wms.geonorge.no https://tiles.mapterhorn.com; connect-src 'self' https://cache.kartverket.no https://wms.geonorge.no https://tiles.mapterhorn.com https://hoydedata.no https://wfs.geonorge.no https://api.met.no; worker-src 'self' blob:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
