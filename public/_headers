# Static assets on Cloudflare Workers.
#
# Two rules, both learned the hard way under `wrangler dev`:
#
# 1. **One pattern per block.** A block that lists several pattern lines applies
#    its headers only to the *last* one; the earlier lines become rules with no
#    headers. `/*.js`, `/*.mjs` and `/*.css` in one block therefore served JS
#    revalidated on every visit (measured: `max-age=0, must-revalidate`) while CSS
#    got `immutable`. Each pattern below has its own block.
# 2. **One definition per header.** Cloudflare concatenates duplicate definitions
#    across matching rules (`nosniff` arrived as "nosniff\nnosniff"), so the
#    security headers live in a single `/*` block and nothing else redefines them.
#
# `tools/verify/served-headers.mjs` asserts the *served* result for each of these
# paths under workerd, because a source-text test cannot see either rule.

# HTML must never be cached immutably. `/index.html` itself 307s to `/`, so both
# spellings are listed: the platform default happened to revalidate `/`, but a
# default is not a policy.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Licence texts change only with the build that writes them. A day, not a year:
# they are not content-hashed, so a changed notice must not be pinned by caches.
/licences/*
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400

# Data changes only when the extract is refreshed (D23).
/data/*
  Cache-Control: public, max-age=3600

# Hashed build output: immutable for a year. One block per pattern — see above.
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.mjs
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# Security headers for every path, including "/" and anything added later.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cache.kartverket.no https://wms.geonorge.no https://tiles.mapterhorn.com; connect-src 'self' https://cache.kartverket.no https://wms.geonorge.no https://tiles.mapterhorn.com https://hoydedata.no https://wfs.geonorge.no https://api.met.no; worker-src 'self' blob:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
