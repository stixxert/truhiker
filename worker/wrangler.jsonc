{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "truhiker-refresh",
  "main": "cron.ts",
  "compatibility_date": "2026-10-01",

  // Monthly resupply refresh, plus a second run three days later.
  //
  // The Worker is stateless — it has no bindings — so the second run cannot tell
  // whether the first succeeded: it always runs. A redundant rebuild of an
  // extract that is three days older is cheaper than a month with no refresh
  // after one failed build, and the logs make a rejected hook visible either way.
  "triggers": {
    "crons": ["0 4 1 * *", "0 4 4 * *"]
  },

  // Logs are how a rejected hook becomes visible. Free plan retains three days;
  // a monthly cron needs longer than that to be diagnosable, so it is on.
  "observability": {
    "enabled": true
  },

  // No routes, no assets, no bindings: a deploy hook URL and a trigger key, both
  // secrets (`wrangler secret put -c worker/wrangler.jsonc`).
  "vars": {}
}
