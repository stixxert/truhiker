{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truhiker",
  "compatibility_date": "2026-10-01",

  // Static-only deployment: there is no Worker script.
  //
  // Nothing in this app needs server-side execution. Every data source
  // (Kartverket WMTS/WFS, Mapterhorn terrain, hoydedata elevation) is CORS-
  // enabled and fetched directly by the browser, which also keeps the browser
  // out of the 100,000 dynamic-requests/day budget entirely.
  //
  // Re-add a Worker ONLY when something genuinely needs server-side execution:
  // a secret we cannot ship to the browser, or traffic high enough that MET asks
  // us to proxy (their terms permit low-volume browser requests identified by
  // Origin — see docs/ARCHITECTURE.md). Neither applies today.
  // The previous Worker entry point is preserved in git history and is roughly
  // 80 lines; the trigger above is the reason to bring it back.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
