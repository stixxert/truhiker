node_modules
dist/
.env
.env.*
*.tmp
.DS_Store
.pi/loop/
.pi/sessions/
.vitest-report.json
.wrangler/

# Scratch files (agent probes, temp scripts) are never committed.
/audit*-tmp.mjs
*.tmp.mjs
.tmp*

# Generated data is a build output, never a committed file (D24).
# The provenance JSON beside it (`data/shops.osm.json`) IS committed: it carries
# the SHA-256, size and counts that a rebuild has to reproduce.
data/*.bin
