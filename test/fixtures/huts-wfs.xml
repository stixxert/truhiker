<?xml version="1.0" encoding="UTF-8"?>
<!--
  One Turrutebasen waypoint on the bundled demo route, in the GML shape
  `app:RuteInfoPunkt` returns (namespace prefixes, `gml:pos` in lat lon).
  The end-to-end gate serves this instead of calling Geonorge: whether the
  journey can open the resupply panel must not depend on a live WFS being up.
  The unavailable-source behaviour is covered by `npm run failure-paths`.
-->
